# LifeOS Configuration

# Root directory to index (required, set via: lifeos init)
LIFEOS_ROOT_DIRECTORY=/path/to/your/folder

# AI Provider: auto, openai, gemini
LIFEOS_AI_PROVIDER=auto

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=your_gcp_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# LifeOS
LIFEOS_DATA_DIR=
LIFEOS_LOG_LEVEL=INFO

# Privacy
LIFEOS_LOCAL_ONLY=false

# Indexing
LIFEOS_MAX_FILE_SIZE_MB=50

# Search
LIFEOS_SEARCH_TOP_K=10
